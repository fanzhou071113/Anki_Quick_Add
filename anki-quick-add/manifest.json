{
  "manifest_version": 3,
  "name": "Anki Quick Add",
  "version": "1.3.0",
  "description": "Add selected text to Anki with optional prompt-based External API diagnostics.",
  "permissions": ["contextMenus", "storage", "notifications"],
  "host_permissions": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {"service_worker": "background.js"},
  "options_page": "options.html"
}